 "listPerson": 168,
 "그 밖의 대조 사건": [
  {
   "p": 191,
   "종류": "원문에 없음",
   "앞부분": "형식은혼자책상에의지하여영채의일을생각하였다."
  },
  {
   "p": 192,
   "종류": "원문에 없음",
   "앞부분": "영채가어찌하여중간에하던이야기를끊고총총히돌아갔는가."
  },
  {
   "p": 193,
   "종류": "원문에 없음",
   "앞부분": "왜이야기를하다가말고그렇게슬피울었는가."
  },
  {
   "p": 194,
   "종류": "원문에 없음",
   "앞부분": "아무리하여도그까닭을알수가없다."
  },
  {
   "p": 195,
   "종류": "원문에 없음",
   "앞부분": "혹내가영채에게대하여불만한거동을보였는가."
  },
  {
   "p": 196,
   "종류": "원문에 없음",
   "앞부분": "아니라,나는영채의말을들을때에지극한동정과정성으로써하였다."
  },
  {
   "p": 197,
   "종류": "원문에 없음",
   "앞부분": "아까영채가물끄러미내얼굴을볼때에나는그눈물고인맑은눈을보고더할수없이사랑하는정이생겼다."
  },
  {
   "p": 198,
   "종류": "원문에 없음",
   "앞부분": "영채는내얼굴에서그빛을보았으려니,그러면어찌하여하던말을중도에끊고그렇게총총히일어갔는고."
  },
  {
   "p": 199,
   "종류": "원문에 없음",
   "앞부분": "암만하여도내게차마말하지못할무슨깊은사정이있나보다."
  },
  {
   "p": 200,
   "종류": "원문에 없음",
   "앞부분": "그러면그것은무슨사정일까."
  },
  {
   "p": 201,
   "종류": "원문에 없음",
   "앞부분": "나를찾아올때에는아무러한사정이라도다말하려고왔겠거늘,어찌하여하던말을그치고총총히돌아갔는고."
  },
  {
   "p": 202,
   "종류": "원문에 없음",
   "앞부분": "옳다,아까주인노파가,'여학생모양을하였으나암만해도기생같습데다'하더니참말그러한가보다."
  },
  {
   "p": 203,
   "종류": "원문에 없음",
   "앞부분": "홀몸으로평양에왔다가어떤못된놈이나년의꼬임에들어그만기생이되었는가보다."
  },
  {
   "p": 204,
   "종류": "원문에 없음",
   "앞부분": "서울서기생노릇을하다가어찌어찌풍편에내가여기있단말을듣고찾아왔던가보다."
  },
  {
   "p": 205,
   "종류": "원문에 없음",
   "앞부분": "만일그렇다하면그가무슨뜻으로나를찾았을까."
  },
  {
   "p": 206,
   "종류": "원문에 없음",
   "앞부분": "어려서같이놀던동무를그리워서한번만나보기나하리라하고나를찾았을까."
  },
  {
   "p": 207,
   "종류": "원문에 없음",
   "앞부분": "그리하여나를만나매,옛날생각이나고부모와형제생각이나서나를보고울다가마침내신세타령을시작한것일까."
  },
  {
   "p": 208,
   "종류": "원문에 없음",
   "앞부분": "그러다가제가기생이되었다는말을하면내가제게대하여불쾌한생각을품을까저어하여하던말을뚝끊고돌아갔음일까"
  },
  {
   "p": 209,
   "종류": "원문에 없음",
   "앞부분": "그러고보면그는실로기생의몸이되었는가."
  },
  {
   "p": 210,
   "종류": "원문에 없음",
   "앞부분": "그은혜많은박선생의따님이그만기생의몸이되었는가."
  },
  {
   "p": 211,
   "종류": "원문에 없음",
   "앞부분": "세상을위하여몸과맘을다바치던열성있는박선생의따님이그만세상의유혹을받아부랑한남자들의노리갯감이되었는"
  },
  {
   "p": 212,
   "종류": "원문에 없음",
   "앞부분": "혹어떤유야랑(遊冶郞)과오늘저녁에만나기를약속하고그약속한시간이오기전에잠깐나를찾은것이아닌가."
  },
  {
   "p": 213,
   "종류": "원문에 없음",
   "앞부분": "또는그유야랑(遊冶郞)을만나러가는길에잠깐내집에들렀던것이아닌가."
  },
  {
   "p": 214,
   "종류": "원문에 없음",
   "앞부분": "그렇게생각하면그럴듯도하다."
  },
  {
   "p": 215,
   "종류": "원문에 없음",
   "앞부분": "아까영채의뒤를따라행길에나갔을때에교동파출소앞으로어떤키큰남자와여자하나가어깨를겯고내려가는양을보았"
  },
  {
   "p": 216,
   "종류": "원문에 없음",
   "앞부분": "그럴진대지금영채는어떤요리점에앉아서어떤부랑한남자와손을마주잡고안기며안으며,한술잔에술을나눠마시며"
  },
  {
   "p": 217,
   "종류": "원문에 없음",
   "앞부분": "아까여기서눈물을흘리던그눈에남자를후리는추파를띄우고그슬픈신세를말하던그입으로는차마입에담지못할더러"
  },
  {
   "p": 218,
   "종류": "원문에 없음",
   "앞부분": "혹지금어떤남자에게안기어더러운쾌락을탐하지나아니하는가."
  },
  {
   "p": 219,
   "종류": "원문에 없음",
   "앞부분": "이러한생각을하니형식의흉중에와락불쾌한생각이난다."
  },
  {
   "p": 220,
   "종류": "원문에 없음",
   "앞부분": "아까내앞에서하던모든가련한모양이말끔일시의외식이로다."
  },
  {
   "p": 221,
   "종류": "원문에 없음",
   "앞부분": "제신세를듣고눈물을흘리는나와노파를보고속으로는깔깔웃었으리로다."
  },
  {
   "p": 222,
   "종류": "원문에 없음",
   "앞부분": "아아,가증한계집이로다하였다."
  },
  {
   "p": 223,
   "종류": "원문에 없음",
   "앞부분": "아아,영채는그만버린계집이되었구나."
  },
  {
   "p": 224,
   "종류": "원문에 없음",
   "앞부분": "더럽고썩어진창기가되고말았구나."
  },
  {
   "p": 225,
   "종류": "원문에 없음",
   "앞부분": "부모를잊고형제를잊고유혹에빠져그만개똥같이더러운몸이되고말았구나."
  },
  {
   "p": 226,
   "종류": "원문에 없음",
   "앞부분": "박선생의집은그만멸망하고말았구나하였다."
  },
  {
   "p": 227,
   "종류": "원문에 없음",
   "앞부분": "형식은머리를들어하염없이방안을돌아보고,책상머리에있는부채를들어훅훅다는얼굴을부치며툇마루에나와앉았"
  },
  {
   "p": null,
   "종류": "원문 문단 누락",
